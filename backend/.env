# Copy this file to ".env" in the backend/ folder and fill in your keys.
# Never commit ".env" (it is listed in .gitignore).

# Google Gemini (primary, free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# Check the current free-tier model name in Google AI Studio before the event.
GEMINI_MODEL=gemini-2.5-flash

# Groq (fallback, free tier): https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend URL(s) allowed by CORS. Separate several with commas.
# Local dev default is the Vite server; add your Vercel URL when you deploy.
FRONTEND_ORIGIN=http://localhost:5173
